# Copy to .env and adjust. `make` and docker compose both read it.

# --- development (make dev) ---
DEV_PORT=5173
# Backend for the Vite /api proxy, as seen from inside the container.
API_PROXY_TARGET=http://host.docker.internal:8080
CHOKIDAR_USEPOLLING=false

# --- production (make prod-up) ---
IMAGE=gwfleet-web
# TAG defaults to the current git commit; set it to pin a release.
# TAG=1.0.0
# Host port for the console (the backend usually has 8080).
WEB_PORT=8081
# Backend base URL (scheme://host:port, no path) that nginx proxies /api to.
API_UPSTREAM=http://host.docker.internal:8080
# Largest request body nginx accepts (firmware image uploads).
CLIENT_MAX_BODY_SIZE=512m

# --- building behind a TLS-intercepting proxy (optional) ---
# BUILD_CA=/path/to/corporate-ca.crt
# DOCKER_BUILD_FLAGS=--network host --build-arg HTTPS_PROXY=http://proxy.example:3128
